# Copy to .env and adjust after `supabase start` (run `supabase status -o env`).

# Supabase local (defaults from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Backend
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
API_CORS_ORIGINS=http://localhost:3000

# Frontend (browser → host services)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set automatically in docker-compose for the web container:
# INTERNAL_SUPABASE_URL=http://host.docker.internal:54321

# Optional: OpenRouter (Jev System 1 + DeepSeek/GLM System 2). Empty = RULES-only.
OPENROUTER_API_KEY=
# Force AI off even if a key is set: AI_ENABLED=false
# AI_ENABLED=
# AES key for BYO OpenRouter keys (urlsafe base64 or any 32+ char string)
BYO_ENCRYPTION_KEY=dev-local-byo-encryption-key-32b!!

# OTel (set automatically in docker-compose for api → otel-lgtm)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
# OTEL_SERVICE_NAME=pegazus-api
